#cloud-config
hostname: ubuntu-server
users:
  - name: ubuntu
    sudo: ALL=(ALL) NOPASSWD:ALL
    groups: sudo, docker
    shell: /bin/bash
    ssh_authorized_keys:
      - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIEfqq1+GA1zkL0o3wXMu37v24NM6hE4qN3OLPa/dIWJD admiq@dubuntu
ssh_pwauth: false
disable_root: true
package_update: true
package_upgrade: true
packages:
  - curl
  - wget
  - git
  - htop
  - net-tools
  - ca-certificates
  - gnupg
  - lsb-release
  - software-properties-common
  - apt-transport-https
  - python3
  - python3-pip
  - openssh-server
  - qemu-guest-agent
runcmd:
  - systemctl enable ssh
  - systemctl start ssh
  - echo "AllowUsers ubuntu" >> /etc/ssh/sshd_config
  - systemctl restart ssh
